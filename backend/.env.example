PORT=8000
DATABASE_URL=postgresql://jurisynth:jurisynth@localhost:5432/jurisynth
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=jurisynth_graph
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=30m
TOTP_ISSUER=JurisynthAI
EMBEDDING_PROVIDER=local
# OPENAI_API_KEY also powers case summarization and Q&A (see /cases/:id/summarize
# and /cases/:id/ask). Without it, both features run a working but weaker
# extractive fallback instead of failing.
# OPENAI_API_KEY=sk-...
CORS_ORIGIN=http://localhost:5173
